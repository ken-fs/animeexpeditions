# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI coding-tool local config (impeccable/plugins) — not part of the site
/.claude/
/.codex/
/.cursor/
/.impeccable/
pnpm-workspace.yaml

# 构建期生成的部署标记（勿入库：入库副本必然滞后一个 commit）
public/deploy-marker.txt
